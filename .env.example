# ── Facebook Graph API ────────────────────────────────
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v23.0
FB_MAX_QPS=3

# 僅 scripts/verify_fb_access.py 的 debug_token 檢查需要；
# 驗證完成後可留空，日常執行不需要。
FB_APP_ID=
FB_APP_SECRET=

# ── 分類引擎 ──────────────────────────────────────────
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-sonnet-5
CLASSIFY_BATCH_SIZE=20

# ── 儲存與隱私 ────────────────────────────────────────
DB_PATH=data/comments.db
NAME_HASH_SALT=
STORE_PLAIN_NAME=false
STORE_RAW_JSON=true
RETENTION_MONTHS=12
LOG_LEVEL=INFO
